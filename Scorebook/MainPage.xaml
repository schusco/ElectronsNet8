<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Scorebook.Converters"
             xmlns:core="clr-namespace:Electrons.Core.Net8;assembly=Electrons.Core.Net8"
             xmlns:games="clr-namespace:Electrons.Core.Net8.Games;assembly=Electrons.Core.Net8"
             xmlns:vo="clr-namespace:Scorebook.ViewObjects"
             xmlns:vm="clr-namespace:Scorebook"
             x:Class="Scorebook.MainPage"
             x:Name="Page">
    <ContentPage.Resources>
        <converters:IntToColorConverter x:Key="BallConverter" ActiveColor="Green" InActiveColor="DarkGray" />
        <converters:IntToColorConverter x:Key="StrikeConverter" ActiveColor="Red" InActiveColor="DarkGray" />
        <converters:IntToColorConverter x:Key="OutConverter" ActiveColor="Blue" InActiveColor="DarkGray" />
        <converters:IntToColorConverter x:Key="RbiConverter" ActiveColor="Red" InActiveColor="DarkGray" />
        <converters:PositionToNameConverter x:Key="PositionToNameConverter" />
        <converters:IntToColorConverter x:Key="BatterHighlightConverter"  ActiveColor="#40C4D527" InActiveColor="Transparent" />
        <DataTemplate x:Key="PlayerRowTemplate">
            <Grid Padding="2" x:Name="PlayerRowContainer" >
                <Label Text="{Binding FullName}" FontSize="Small" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LineupRowTemplate">
            <Grid Padding="2" x:Name="PlayerRowContainer" BackgroundColor="{Binding IsActive, Converter={StaticResource BatterHighlightConverter}}">
                <Label Text="{Binding Player.FullName}" FontSize="Small" />
            </Grid>
        </DataTemplate>
        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#512BD4" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#6542D0" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled" >
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="LightGray" />
                                <Setter Property="TextColor" Value="Black" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="WidthRequest" Value="130" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontSize" Value="Small" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="IsEnabled" Value="{Binding IsGameStarted}" />
        </Style>
        <Style x:Key="PitchButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="WidthRequest" Value="115" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="IsEnabled" Value="{Binding IsGameStarted}" />
        </Style>
        <Style x:Key="ScoringButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="WidthRequest" Value="115" />
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="IsEnabled" Value="{Binding IsGameStarted}" />
        </Style>
        <Style x:Key="LineupButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="WidthRequest" Value="150" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="PositionButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="BackgroundColor" Value="#80000000" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="WidthRequest" Value="40" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#AA000000" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled" >
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="LightGray" />
                                <Setter Property="TextColor" Value="Black" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="NextBatterStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="WidthRequest" Value="200" />
            <Setter Property="HeightRequest" Value="60" />
            <Setter Property="BackgroundColor" Value="LightBlue" />
            <Setter Property="FontSize" Value="Small" />
            <Setter Property="TextColor" Value="Black" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="1" />
                                <Setter Property="Opacity" Value="1" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.95" />
                                <Setter Property="Opacity" Value="0.8" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#1787AD" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
        <Style x:Key="OutButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#80000000" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="WidthRequest" Value="10" />
            <Setter Property="HeightRequest" Value="10" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style x:Key="StatsHeaderStyle" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="StatsRowStyle" TargetType="Label">
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="3" />
        </Style>
        <Style x:Key="LineScoreStyle" TargetType="Label">
            <Setter Property="FontSize" Value="Large" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="HeightRequest" Value="50" />
        </Style>
        <Color x:Key="ActiveHitZoneColor">Yellow</Color>
        <x:Double x:Key="ActiveHitZoneOpacity">0.5</x:Double>
    </ContentPage.Resources>
    <Shell.TitleView>
        <Grid ColumnDefinitions="*, *">
            <Label Text="Baseball Scorekeeper" VerticalOptions="Center" FontAttributes="Bold" />
            <Button Grid.Column="1" Text="Save Game" Command="{Binding SaveCommand}" BackgroundColor="Transparent" TextColor="Black" Margin="0,0,10,0" />
        </Grid>
    </Shell.TitleView>
    <Grid RowDefinitions="*" Padding="10" ColumnSpacing="10"  >
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideBarColumnLeft" Width="{OnPlatform WinUI=.125*, Android=0}" />
            <ColumnDefinition Width="{OnPlatform WinUI=.75*, Android=*}" />
            <ColumnDefinition x:Name="SideBarColumnRight" Width="{OnPlatform WinUI=.125*, Android=0}" />
        </Grid.ColumnDefinitions>
        <BoxView Grid.ColumnSpan="3" BackgroundColor="#AA000000" WidthRequest="100" IsVisible="{Binding ShowLineupBackGround}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding ToggleSidebarCommand}" Tapped="TapGestureRecognizer_Tapped_1" />
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border Grid.Column="0" BackgroundColor="White" IsVisible="{Binding IsSideBarOpen}"  HorizontalOptions="Start">
            <ScrollView Orientation="Vertical">
                <VerticalStackLayout  Spacing="5">
                    <Border Padding="5">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding HomeTeamName}" HorizontalOptions="Center" FontAttributes="Bold"/>
                            <Button Text="{Binding HomeSubText}" Style="{StaticResource LineupButtonStyle}" Command="{Binding SetLineupCommand}" CommandParameter="{x:Boolean True}" />
                        </VerticalStackLayout>
                    </Border>
                    <CollectionView ItemsSource="{Binding HomeLineup}" HeightRequest="300" ItemTemplate="{StaticResource LineupRowTemplate}" SelectionMode="Single" 
                                SelectionChangedCommand="{Binding HomeSubstitutePlayerCommand}" SelectionChangedCommandParameter="{Binding Source={RelativeSource Self}, Path=SelectedItem}">
                    </CollectionView>
                    <Border>
                        <Button Text="{Binding HomePitcherText}" Style="{StaticResource LineupButtonStyle}" Command="{Binding SelectPitcherCommand}" CommandParameter="{x:Boolean True}" />
                    </Border>
                    <Border>
                        <Label Text="{Binding HomePitcherName}"  FontSize="Small" Margin="5" />
                    </Border>
                    <Button Text="View Stats" Command="{Binding SetStatsCommand}" Style="{StaticResource LineupButtonStyle}" CommandParameter="{x:Boolean True}" />
                    <Border>
                        <Label FontSize="Small" Text="Bench" Margin="10,10,0,0"/>
                    </Border>
                    <Border MaximumHeightRequest="150">
                        <CollectionView ItemsSource="{Binding Game.HomeTeam.Bench}" ItemTemplate="{StaticResource PlayerRowTemplate}" />
                    </Border>
                    <Border>
                        <Label FontSize="Small" Text="Replaced" Margin="10,10,0,0"/>
                    </Border>
                    <Border MaximumHeightRequest="150">
                        <CollectionView ItemsSource="{Binding Game.HomeTeam.Replaced}" ItemTemplate="{StaticResource PlayerRowTemplate}" BackgroundColor="#f0f0f0" />
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
        <ScrollView Grid.Column="1" Grid.ColumnSpan="{OnPlatform WinUI=1, Android=3}" IsVisible="{Binding ShowMainArea}" >
            <Grid RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{OnPlatform WinUI=.2*,Android=Auto}"/>
                    <ColumnDefinition Width="{OnPlatform WinUI=.5*,Android=Auto}"/>
                    <ColumnDefinition Width="{OnPlatform WinUI=.2*,Android=Auto}"/>
                    <ColumnDefinition Width="{OnPlatform WinUI=.3*,Android=Auto}"/>
                </Grid.ColumnDefinitions>
                <Label x:Name="InningLabel" Text="Inning Log" Margin="0,10,0,0" HorizontalOptions="Center" FontSize="Medium" Grid.Column="3"/>
                <VerticalStackLayout Grid.Column="1">
                    <Grid ColumnDefinitions="40,Auto,*,*,50,40" RowDefinitions="Auto,Auto,Auto" BackgroundColor="#F0F0F0" Padding="10" Margin="0,0,0,0" ColumnSpacing="20">
                        <Label Grid.Column="0" Text="{Binding Game.HomeScore}" FontSize="32" VerticalOptions="Center" HorizontalOptions="Center" />
                        
                        <HorizontalStackLayout Spacing="15" Grid.Column="1" Grid.ColumnSpan="3" >
                            <HorizontalStackLayout Spacing="2" Grid.Column="2">
                                <Label Text="B" VerticalOptions="Center" FontAttributes="Bold" Margin="5" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentBalls, Converter={StaticResource BallConverter}, ConverterParameter=1}" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentBalls, Converter={StaticResource BallConverter}, ConverterParameter=2}" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentBalls, Converter={StaticResource BallConverter}, ConverterParameter=3}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="2" Grid.Column="2">
                                <Label Text="S" VerticalOptions="Center" FontAttributes="Bold" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentStrikes, Converter={StaticResource StrikeConverter}, ConverterParameter=1}" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentStrikes, Converter={StaticResource StrikeConverter}, ConverterParameter=2}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="2" Grid.Column="2">
                                <Label Text="O" VerticalOptions="Center" FontAttributes="Bold" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentOuts, Converter={StaticResource OutConverter},ConverterParameter=1}" />
                                <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentOuts, Converter={StaticResource OutConverter},ConverterParameter=2}" />
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="2" Grid.Column="4">
                            <Image  IsVisible="{Binding IsTopHalfOfInning}" Source="caret_up_fill.png"  WidthRequest="20" HeightRequest="20" BackgroundColor="#F0F0F0" />
                            <Image IsVisible="{Binding IsBottomHalfOfInning}" Source="caret_down_fill.png"  WidthRequest="20" HeightRequest="20" BackgroundColor="#F0F0F0" />
                            <Label Text="{Binding InningNumber}" FontSize="Medium" VerticalOptions="Center" HorizontalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="5" Text="{Binding Game.AwayScore}" FontSize="32" VerticalOptions="Center" HorizontalOptions="Center" />
                        <Label Grid.ColumnSpan="3" Grid.Row="1" HorizontalOptions="Start" Text="{Binding Game.HomeTeam.Name}" FontSize="12"  IsVisible="{Binding HomeMobileText.Length}" />
                        <Label Grid.ColumnSpan="3" Grid.Column="3" Grid.Row="1" HorizontalOptions="End" Text="{Binding Game.AwayTeam.Name}"  IsVisible="{Binding HomeMobileText.Length}" FontSize="12" />
                        <Label Text="{Binding HomeMobileText}" IsVisible="{Binding HomeMobileText.Length}" Grid.ColumnSpan="3" Grid.Row="2" HorizontalOptions="Start" FontSize="12" TextColor="Black" />
                        <Label Text="{Binding AwayMobileText}" IsVisible="{Binding HomeMobileText.Length}" Grid.ColumnSpan="3" Grid.Column="3" Grid.Row="2" HorizontalOptions="End" FontSize="12" TextColor="Black"  />
                    </Grid>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center" IsVisible="{Binding ShowDesktopActionButtons}" Grid.Row="0" Grid.RowSpan="2" >
                    <Button Grid.Column="0" Text="1B"  Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Single}"  />
                    <Button Grid.Column="0" Text="2B" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Double}"  />
                    <Button Grid.Column="0" Text="3B" IsVisible="{Binding ShowDesktopActionButtons}" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Triple}"  />
                    <Button Grid.Column="0" Text="HR" IsVisible="{Binding ShowDesktopActionButtons}" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.HomeRun}"  />
                    <Button Grid.Column="0" Text="BB" IsVisible="{Binding ShowDesktopActionButtons}" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Walk}"  />
                    <Button Grid.Column="0" Text="HBP" IsVisible="{Binding ShowDesktopActionButtons}" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.HitByPitch}"  />
                    <Button Grid.Column="0" Text="Other" IsVisible="{Binding ShowDesktopActionButtons}" Style="{StaticResource ActionButtonStyle}" Command="{Binding ShowOtherMenuCommand}"  />
                    <Border  Padding="5" WidthRequest="130">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Batting" HorizontalOptions="Center" FontSize="Small" Grid.Column="0" Grid.Row="2" IsVisible="{Binding ShowDesktopActionButtons}" />
                            <Label Text="{Binding CurrentAb.Batter.FullName}" FontSize="Small" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="2" IsVisible="{Binding ShowDesktopActionButtons}" />
                            <Label Text="Previous Abs" IsVisible="{Binding ShowDesktopActionButtons}" HorizontalOptions="Center" TextDecorations="Underline" WidthRequest="100" FontAttributes="None" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreviousAtBats}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Label Text="{Binding .}" HorizontalTextAlignment="Start" LineBreakMode="WordWrap" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <FlexLayout x:Name="MainArea" Grid.Column="1" Grid.Row="1" Direction="Column" AlignItems="Start"  Wrap="NoWrap" JustifyContent="Start" >
                    <Grid MinimumHeightRequest="400" MinimumWidthRequest="400" HorizontalOptions="Fill" BackgroundColor="DarkGreen" FlexLayout.Grow="0" FlexLayout.AlignSelf="Stretch" >
                        <Image Source="baseballdiamond.gif" Aspect="AspectFill" />
                        <Grid ColumnDefinitions="*,*,*" RowDefinitions=".2*,.2*,.3*,.3*">
                            <Button Grid.Row="0" Grid.Column="1" Text="8" Margin="0,0,0,10" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position.CF}" />
                            <Label Grid.Row="0" Grid.Column="1" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[CF]}" HorizontalOptions="Center" TextColor="White" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding RunnerOnSecond}" StyleId="SecondBaseLbl" IsVisible="{Binding ShowFieldPositionLinks}" HorizontalOptions="Center" Margin="0,-10,0,0" TextColor="White" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped" CommandParameter="2"  />
                                </Label.GestureRecognizers>
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextDecorations" Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding RunnerOnSecondIsOut}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <Button Grid.Row="0" Grid.Column="0" Text="7" Margin="0,20,0,0" Style="{StaticResource PositionButtonStyle}" 
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position.LF}" HorizontalOptions="Center" IsVisible="{Binding ShowFieldPositionLinks}" />
                            <Label Grid.Row="0" Grid.Column="0" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[LF]}" HorizontalOptions="Center" TextColor="White" />
                            <Button Grid.Row="0" Grid.Column="2" Text="9" Margin="0,20,0,0" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position.RF}" HorizontalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[RF]}" HorizontalOptions="Center" TextColor="White" />
                            <Button Grid.Row="1" Grid.Column="0" Text="6" Margin="70,0,0,30" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position.SS}" HorizontalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="0" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[SS]}" HorizontalOptions="Center" TextColor="White" />
                            <Button Grid.Row="1" Grid.Column="2" Text="4" Margin="0,0,70,30" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position._2B}" HorizontalOptions="Center" />
                            <Label Grid.Row="1" Grid.Column="2" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[2B]}" HorizontalOptions="Center" TextColor="White" />
                            <Label Grid.Row="2" Grid.Column="0" StyleId="ThirdBaseLbl" Text="{Binding RunnerOnThird}" IsVisible="{Binding ShowFieldPositionLinks}"  Margin="10,0,0,0" TextColor="White" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped" CommandParameter="4"  />
                                </Label.GestureRecognizers>
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextDecorations" Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding RunnerOnThirdIsOut}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <Button Grid.Row="2" Grid.Column="0" Text="5" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position._3B}" />
                            <Label Grid.Row="2" Grid.Column="0" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[3B]}" HorizontalOptions="Center" TextColor="White" />
                            <Button Grid.Row="2" Grid.Column="1" Text="1" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position.P}" />
                            <Label Grid.Row="2" Grid.Column="1" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[P]}" HorizontalOptions="Center" TextColor="White" />
                            <Label StyleId="FirstBaseLbl" Grid.Row="2" Grid.Column="2" Text="{Binding RunnerOnFirst}" IsVisible="{Binding ShowFieldPositionLinks}" Margin="10,0,0,0" TextColor="White" >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer  Tapped="TapGestureRecognizer_Tapped" CommandParameter="1" />
                                </Label.GestureRecognizers>
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="TextDecorations" Value="None" />
                                        <Style.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding RunnerOnFirstIsOut}" Value="True">
                                                <Setter Property="TextDecorations" Value="Strikethrough" />
                                                <Setter Property="TextColor" Value="Gray" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                            <Button Grid.Row="2" Grid.Column="2" Text="3" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position._1B}" />
                            <Label Grid.Row="2" Grid.Column="2" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[1B]}" HorizontalOptions="Center" TextColor="White" />
                            <Label Grid.Row="3" Grid.Column="1" Margin="10" IsVisible="{Binding ShowDefensiveAlignment}" Text="{Binding Defense[C]}" HorizontalOptions="Center" TextColor="White" />
                            <VerticalStackLayout Grid.Row="3" Grid.Column="1">
                                <Button Text="&lt;-" Command="{Binding SendRunnerBackCommand}" IsVisible="{Binding SendRunnerBackButtonVisible}" WidthRequest="40" BackgroundColor="Gray" />
                                <Button  Text="2" Style="{StaticResource PositionButtonStyle}" IsVisible="{Binding ShowFieldPositionLinks}"
                                    Command="{Binding PositionLinkCommand}" CommandParameter="{x:Static games:Position.C}" />

                            </VerticalStackLayout >
                            <VerticalStackLayout Grid.Column="2" Grid.Row="3" Spacing="5" Margin="15,15,0,0" HorizontalOptions="Center">
                                <Label Text="RBI" TextColor="White" HorizontalOptions="Center" />
                                <Border >
                                    <VerticalStackLayout Spacing="5" Padding="5">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="RbiTapGestureRecognizer_Tapped"/>
                                        </VerticalStackLayout.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="5">
                                            <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentRbis, Converter={StaticResource RbiConverter}, ConverterParameter=1}" />
                                            <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentRbis, Converter={StaticResource RbiConverter}, ConverterParameter=2}" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="5">
                                            <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentRbis, Converter={StaticResource RbiConverter}, ConverterParameter=3}" />
                                            <BoxView WidthRequest="15" HeightRequest="15" Color="{Binding CurrentRbis, Converter={StaticResource RbiConverter}, ConverterParameter=4}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Grid x:Name="FieldOverlay" IsVisible="{Binding IsFieldOverlayVisible}" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
