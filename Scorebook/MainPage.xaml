                    <Label Grid.Column="1" Text="AB" Style="{StaticResource StatsHeaderStyle}"  />
                    <Label Grid.Column="2" Text="R" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="3" Text="H" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="4" Text="2B" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="5" Text="3B" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="6" Text="HR" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="7" Text="RBI" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="8" Text="BB" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="9" Text="K" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="10" Text="SB" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="11" Text="CS" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="12" Text="HBP" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="13" Text="SAC" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="14" Text="SF" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="15" Text="AVG" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="16" Text="SLG" Style="{StaticResource StatsHeaderStyle}" />
                    <Label Grid.Column="17" Text="OBP" Style="{StaticResource StatsHeaderStyle}" />
                </Grid>

                <CollectionView Grid.Row="3" ItemsSource="{Binding GameHittingStats}" BackgroundColor="White" Margin="10">
                    <CollectionView.ItemTemplate  >
                        <DataTemplate >
                            <Grid BackgroundColor="{Binding RowColor}" ColumnDefinitions="150, 50, 50, 50,50, 50, 50,50, 50, 50,50, 50, 50,50,50, 80, 80, 80">
                                <Label Grid.Column="0" Text="{Binding StatLine.PlayerName}" Style="{StaticResource StatsRowStyle}" HorizontalTextAlignment="Start" />
                                <Label Grid.Column="1" Text="{Binding StatLine.AB}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="2" Text="{Binding StatLine.Runs}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="3" Text="{Binding StatLine.H}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="4" Text="{Binding StatLine.Doubles}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="5" Text="{Binding StatLine.Triples}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="6" Text="{Binding StatLine.HR}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="7" Text="{Binding StatLine.RBI}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="8" Text="{Binding StatLine.BB}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="9" Text="{Binding StatLine.K}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="10" Text="{Binding StatLine.SB}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="11" Text="{Binding StatLine.CS}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="12" Text="{Binding StatLine.HBP}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="13" Text="{Binding StatLine.SAC}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="14" Text="{Binding StatLine.SF}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="15" Text="{Binding StatLine.BaFormatted}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="16" Text="{Binding StatLine.SlgFormatted}" Style="{StaticResource StatsRowStyle}" />
                                <Label Grid.Column="17" Text="{Binding StatLine.ObpFormatted}" Style="{StaticResource StatsRowStyle}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Grid.Row="4" Text="Close" Command="{Binding CloseStatsViewCommand}" />
            </Grid>
        </ScrollView>
        <Grid Grid.ColumnSpan="3" Grid.RowSpan="1" BackgroundColor="#AA000000" InputTransparent="False" IsVisible="{Binding ShowLineScore}" RowDefinitions="2*, 2*,2*, 1*,1*"
              ColumnDefinitions="1*,3*,1*">
            <Border Grid.Column="1" Grid.Row="1" Padding="10" BackgroundColor="White" >

                <Grid ColumnDefinitions="200,*,80,80,80" RowDefinitions="Auto">

                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Final" FontSize="Large" HeightRequest="50" BackgroundColor="#EEE" />
                        <Label Text="{Binding Game.AwayTeam.Name}" FontSize="Large" HeightRequest="50" />
                        <Label Text="{Binding Game.HomeTeam.Name}" FontSize="Large" HeightRequest="50" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="R" FontSize="Large" BackgroundColor="#EEE" Style="{StaticResource LineScoreStyle}" />
                        <Label Text="{Binding Game.AwayScore}" Style="{StaticResource LineScoreStyle}" />
                        <Label Text="{Binding Game.HomeScore}" Style="{StaticResource LineScoreStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="H" FontSize="Large" BackgroundColor="#EEE" Style="{StaticResource LineScoreStyle}" />
                        <Label Text="{Binding Game.AwayHits}" FontSize="Large" Style="{StaticResource LineScoreStyle}" />
                        <Label Text="{Binding Game.HomeHits}" FontSize="Large" Style="{StaticResource LineScoreStyle}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4">
                        <Label Text="E" FontSize="Large" BackgroundColor="#EEE" Style="{StaticResource LineScoreStyle}" />
                        <Label Text="{Binding Game.AwayErrors}" FontSize="Large" Style="{StaticResource LineScoreStyle}" />
                        <Label Text="{Binding Game.HomeErrors}" FontSize="Large" Style="{StaticResource LineScoreStyle}" />
                    </VerticalStackLayout>

                    <FlexLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding LineScore}" Direction="Row" JustifyContent="Start" AlignItems="Stretch" AlignContent="Stretch">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid RowDefinitions="50,50,50" FlexLayout.Grow="1" ColumnSpacing="0" RowSpacing="0" Margin="0,0,-1,0">
                                    <BoxView Grid.Row="0" Color="#EEE" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                    <Label Grid.Row="0" Text="{Binding InningNumber}" Style="{StaticResource LineScoreStyle}" />
                                    <Label Grid.Row="1" Text="{Binding AwayRuns}" Style="{StaticResource LineScoreStyle}" />
                                    <Label Grid.Row="2" Text="{Binding HomeRuns}" Style="{StaticResource LineScoreStyle}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </Grid>
            </Border>
            <Border Grid.Column="1" Grid.Row="2" BackgroundColor="White" >
                <VerticalStackLayout >
                    <HorizontalStackLayout>
                        <Label Text="WP:" Margin="5" FontSize="Large" VerticalTextAlignment="Center" />
                        <Label Text="{Binding Game.WinningPitcher.FullName}" Margin="5" FontSize="Large" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="LP:" Margin="5"  FontSize="Large" />
                        <Label Text="{Binding Game.LosingPitcher.FullName}" Margin="5" FontSize="Large" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="SV:" IsVisible="{Binding SaveAwarded}" Margin="5" FontSize="Large" />
                        <Label Text="{Binding SaveAwardedTo}" IsVisible="{Binding SaveAwarded}" Margin="5" FontSize="Large" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <Button Text="Close" Grid.Column="1" Grid.Row="3" FontSize="Medium" Command="{Binding CloseLineScoreCommand}" />
        </Grid>
        <FlexLayout Grid.ColumnSpan="3" Grid.RowSpan="1" Direction="Row" Wrap="Wrap" JustifyContent="Center" AlignContent="Center" Padding="10"
                    BackgroundColor="#CC000000" ZIndex="10" IsVisible="{Binding ShowActionDialog}">
            <Button Text="1B"  Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Single}"  />
            <Button Text="2B" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Double}"  />
            <Button Text="3B" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Triple}"  />
            <Button Text="HR" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.HomeRun}"  />
            <Button Text="BB" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Walk}"  />
            <Button Text="HBP" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.HitByPitch}"  />
            <Button Text="Other" Style="{StaticResource ActionButtonStyle}" Command="{Binding ShowOtherMenuCommand}"  />
            <Button Text="K" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.StrikeOut}"  />
            <Button Text="Fly Ball" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.FlyOut}"  />
            <Button Text="Error" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.ReachedOnError}"  />
            <Button Text="FC" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.FieldersChoice}"  />
            <Button Text="SB" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.StolenBase}"  />
            <Button Text="CS" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.OutStealing}"  />
            <Button Text="SAC" Style="{StaticResource ActionButtonStyle}" Command="{Binding ScoringEnteredCommand}" CommandParameter="{x:Static games:AB.Sacrifice}"  />
        </FlexLayout>
    </Grid>
</ContentPage>
