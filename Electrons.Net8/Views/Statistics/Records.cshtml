@model LeadersModel
@using Elecredesign.Core;
@using Electrons.Core.Net8
@using Electrons.Net8.Models
@{
    ViewBag.Title = "Electrons All Time Leaders";
}

<div class="container-fluid">
    <div id="loadingDiv" class="spinner-border ">
        <span role="status">Loading...</span>
    </div>
    <div class="row mt-2">
        <div class="col col-auto mx-auto">
            <h3>Electron Records</h3>
        </div>
    </div>
    <div class="row">
        <div class="col col-sm-5 mx-auto">
            <form id="myForm" action="GetLeaders">
                <ul class="nav nav-tabs nav-justified" role="tablist" style="background-color:#ddd">
                    <li role="presentation" class="nav-item active"><a href="#hit" aria-controls="hit" role="tab" class="nav-link" data-bs-toggle="tab">Hitting Stats</a></li>
                    <li role="presentation" class="nav-item"><a href="#pitch" aria-controls="pitch" role="tab" class="nav-link" data-bs-toggle="tab">Pitching Stats</a></li>
                </ul>
                <div class="tab-content">
                    <div role="tabpanel" class="tab-pane active" id="hit">
                        <div class="row m-3" >
                            <div class="col-sm-7 mt-2">
                                @Html.RadioButtonFor(m => m.HitCategory, StatsCategory.Season, new { id = "hitseason",@class="hit ms-2" })<span style="margin-left:5px;margin-right:5px">Season</span>
                                @Html.RadioButtonFor(m => m.HitCategory, StatsCategory.Career, new { id = "hitcareer", @class = "hit ms-2" })<span style="margin-left:5px;margin-right:5px">Career</span>
                                @Html.RadioButtonFor(m => m.HitCategory, StatsCategory.Playoff, new { id = "hitplayoff", @class = "hit ms-2" })<span style="margin-left:5px">Playoff</span>
                            </div>
                            <div class="col-sm-3">
                                @Html.DropDownListFor(m => m.SelectedCategory, Model.HitCategories, "-- Select --", new { @class = "form-control", width = "50px" })
                            </div>
                            <div class="col-sm-2">
                                <input type="button" name="Hit" class="btn btn-outline-primary getleaders" value="Search" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 mb-1">
                                <span style="font-size:.8em;">@Model.HittingThresholdString</span>
                            </div>
                        </div>
                    </div>
                    <div role="tabpanel" class="tab-pane" id="pitch">
                        <div class="row m-3">
                            <div class="col-sm-7 mt-2">
                                @Html.RadioButtonFor(m => m.PitchCategory, StatsCategory.Season, new { id = "hitseason", @class = "pitch" })<span style="margin-left:5px;margin-right:5px">Season</span>
                                @Html.RadioButtonFor(m => m.PitchCategory, StatsCategory.Career, new { id = "hitcareer", @class = "pitch" })<span style="margin-left:5px;margin-right:5px">Career</span>
                                @Html.RadioButtonFor(m => m.PitchCategory, StatsCategory.Playoff, new { id = "hitplayoff", @class = "pitch" })<span style="margin-left:5px">Playoff</span>
                            </div>
                            <div class="col-sm-3">
                                @Html.DropDownListFor(m => m.SelectedPitchCategory, Model.PitchCategories, "-- Select --", new { @class = "form-control", width = "50px" })
                            </div>
                            <div class="col-sm-2">
                                <input id="submitBtn" type="button"  name="Pitch" class="btn btn-outline-primary getleaders" value="Search" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-sm-12 mb-1">
                                <span style="font-size:.8em;">@Model.PitchingThresholdString</span>
                            </div>
                        </div>
                    </div>
                </div>
                <div id="stats"></div>
            </form>
        </div>
    </div>
</div>