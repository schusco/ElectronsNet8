@using Electrons.Net8
@using Electrons.Net8.Models
@model LiveGameModel
<table class="linescore">
    <tr>
        <th style="width:30px"></th>
        <th ></th>
        @{
            var totalInnings = Model.TotalInnings;            
            if (Model.AwayInnings.Count > 7)
            {
                totalInnings = Model.AwayInnings.Count;
            }
            for (int i = 1; i <= totalInnings; i++)
            {                
                <th>@i</th>
            }
        }
        <th>R</th>
        <th>H</th>
        <th>E</th>
    </tr>
    <tr class="awayrow">
        <td>@Html.Image(Model.AwayLogo,"24")</td>
        <td style="text-align:left;min-width:120px">@Model.AwayName</td>
        @for (int i = 0; i < totalInnings; i++)
        {
            if (i >= Model.AwayInnings.Count)
            {
                <td class="text-center">-</td>
            }
            else
            {
                var currentInning = i + 1;
                var inningClass = Model.InningHalf == Electrons.Core.Net8.HalfInning.Top && currentInning == Model.InningNumber && !Model.GameIsOver ? "activeInning" : "";
                <td class="text-center @inningClass">@Model.AwayInnings[i]</td>
            }
        }
        <td id="awayRunsLs" class="text-center">@Model.AwayScore</td>
        <td id="awayHitsLs" class="text-center">@Model.AwayHits</td>
        <td id="awayErrorsLs" class="text-center">@Model.AwayErrors</td>
    </tr>
    <tr class="homerow">
        <td>@Html.Image(Model.HomeLogo,"24")</td>
        <td style="text-align:left;min-width:100px;">@Model.HomeName</td>
        @for (int i = 0; i < totalInnings; i++)
        {
            if (i >= Model.HomeInnings.Count)
            {
                <td class="text-center">-</td>
            }
            else
            {
                var currentInning = i + 1;
                var inningClass = Model.InningHalf == Electrons.Core.Net8.HalfInning.Bottom && currentInning == Model.InningNumber && !Model.GameIsOver ? "activeInning" : "";
                <td class="text-center @inningClass">@Model.HomeInnings[i]</td>
            }
        }
        <td id="homeRunsLs" class="text-center">@Model.HomeScore</td>
        <td id="homeHitsLs" class="text-center">@Model.HomeHits</td>
        <td id="homeErrorsLs" class="text-center">@Model.HomeErrors</td>
    </tr>
    <tfoot>
        <tr>@{
                var TotalColumns = Model.TotalInnings + 5;
                var locColumns = TotalColumns / 2;
                var dateColumns = TotalColumns - locColumns;
            }
            <td colspan="@locColumns" >
                @Model.LocationText&nbsp;&nbsp;<span style="font-size:11px;color:#666">@Model.CityText</span>
            </td>
            <td colspan="@dateColumns" style="text-align:right; padding-right:1em">
                @Model.DateString
            </td>
        </tr>
    </tfoot>
</table>