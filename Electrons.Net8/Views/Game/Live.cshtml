@using Elecredesign
@using Electrons.Core.Net8
@using Electrons.Net8
@using Electrons.Net8.Models
@model LiveGameModel
@{
    Layout = "~/Views/Shared/_NoHeaderLayout.cshtml";
    ViewBag.Title = Model.Title;
    ViewData.Add("home", false);
    ViewData.Add("logo", Model.AwayLogo);
    ViewData.Add("team", Model.AwayName);
    ViewData.Add("image", "~/Content/images/baseballDiamond.gif");
}
@section Scripts {
    <script src="~/Scripts/liveupdate.js"></script> 
    <script>
        const connection = new signalR.HubConnectionBuilder()
                    .withUrl(baseurl+"scorehub")
                    .withAutomaticReconnect([0, 2000, 5000, 10000, null])
                    .build();
        connection.serverTimeoutInMilliseconds=30000; // 30 second timeout
        connection.keepAliveIntervalInMilliseconds= 15000; // 15 second keep alive ping

        connection.on("ReceiveAbUpdate", (ab) => {
            // 1. Find the elements on the page
            console.log("Received AB update: ", ab);                     
            
            try { updateScoreboard(ab); }
            catch(e) { console.error('scoreboard update failed: ',e); }

            try { updateAbData(ab); }
            catch(e) { console.error('ab update failed: ', e); }
            
            try { updateLineScore(ab); }
            catch(e) { console.error('linescore update failed: ',e); }              
            
        });
        connection.on("GameUpdated", (game) => {
            console.log("Received game update: ", game);
            fetch('/Game/GetPlayByPlayPartial?gameId=@Model.GameId').then(response => response.text()).then(html => {
                document.getElementById('playbyplay').innerHTML = html;
            }).catch(err => console.error("Failed to update play by play: ", err));
            fetch(`/Game/GetScoringPlaysPartial?gameId=@Model.GameId`).then(response => response.text()).then(html => {
                const splays=document.getElementById('scoringplays');
                if (splays){
                    splays.innerHTML = html;
                }
                const pbpscoring=  document.getElementById('pbpscoring');
                if (pbpscoring){
                    pbpscoring.innerHTML = html;
                }
            }).catch(err => console.error("Failed to update scoring plays: ", err));
            fetch(`/Game/GetBoxScorePartial?gameId=@Model.GameId&home=false`).then(response => response.text()).then(html => {
                const boxScore = document.getElementById('awayBox');
                if (boxScore) {
                    boxScore.innerHTML = html;
                }
            }).catch(err => console.error("Failed to update box score: ", err));
            fetch(`/Game/GetBoxScorePartial?gameId=@Model.GameId&home=true`).then(response => response.text()).then(html => {
                const boxScore = document.getElementById('homeBox');
                if (boxScore) {
                    boxScore.innerHTML = html;
                }
            }).catch(err => console.error("Failed to update box score: ", err));
        });
        connection.start().catch(err => console.error(err));
        setInterval(() =>{
            if (connection.state === signalR.HubConnectionState.Connnected) {
                connection.invoke("Heartbeat").catch(err => console.error("Heartbeat failed: ", err));
            }
        }, 20000);
        function updateLineScore(ab) {
            const rowSelector=ab.inning.top ? '.awayrow':'.homerow';
            const selector = `table.linescore ${rowSelector} td.activeInning`;
            const currentInningEl = document.querySelector(selector);
            if (currentInningEl) {
                currentInningEl.textContent= ab.inning.runs ? ab.inning.runs : "0";
            }
            const homeRuns = document.getElementById('homeRunsLs');
            const homeHits = document.getElementById('homeHitsLs');
            const homeErrors = document.getElementById('homeErrorsLs')
            const awayRuns = document.getElementById('awayRunsLs');
            const awayHits = document.getElementById('awayHitsLs');
            const awayErrors = document.getElementById('awayErrorsLs')
            homeRuns.textContent = ab.score.home;
            homeHits.textContent = ab.hits.home;
            homeErrors.textContent = ab.errors.home;
            awayRuns.textContent = ab.score.away;
            awayHits.textContent = ab.hits.away;
            awayErrors.textContent = ab.errors.away;
        }        
    </script>
}
<nav class="navbar navbar-expand-sm fixed-top ">

    <div class="tronHeaderbar" style="width:100%;height:100px;margin-top:0">
        <div class="container-fluid">
            <div class="row wide align-content-center">
                <div class="col-1 my-auto">
                    <div class="navbar-left my-auto ms-3">
                        <div class="dropdown">
                            <button type="button" class="btn dropdown-toggle menuButton" title="Navigation menu" data-toggle="dropdown" id="navmenu">
                                <i class="bi bi-list"></i>
                            </button>
                            <div class="dropdown-menu" aria-labelledby="navmenu" style="background: #800000">
                                <a href="~/" class="headerLink menuStyle dropdown-item">Home</a>
                                <a href="~/Schedule" class="headerLink menuStyle dropdown-item">Schedule</a>
                                <a href="~/Statistics" class="headerLink menuStyle dropdown-item">Statistics</a>
                                <a href="~/Roster" class="headerLink menuStyle dropdown-item">Roster</a>
                                <a href="~/DepthChart" class="headerLink menuStyle dropdown-item">Depth Chart</a>
                                <a href="~/History" class="headerLink menuStyle dropdown-item">History</a>
                                <a href="~/Ballpark" class="headerLink menuStyle dropdown-item">Ball Park</a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-10 text-center">
                    <div class="row">
                        <div class="col-4">
                            <div class="navbar-header d-inline">

                                <div class="navbar-brand navbar-left mr-lg-3 d-none d-md-inline teamName">
                                    @Html.Image(@Model.AwayLogo, "70")
                                </div>
                                <h3 id="awayTeamName" class="navbar-text navbar-left mr-lg-3 teamName d-none d-lg-inline">@Model.AwayName</h3>
                                <h1 id="awayscore-@Model.GameId" class="navbar-text navbar-left scoreStyle">@Model.AwayScore</h1>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="navbar-text ">
                                <div class="navbar-text" style="margin-top:5px">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (Model.GameIsOver)
                                        {
                                            <span class="sbStyle">Final</span>
                                        }
                                        else if (!Model.IsStarted)
                                        {
                                            <span class="sbStyle">@string.Format("Game Time: {0}", Model.GameTime)</span>
                                        }
                                        else
                                        {
                                            if (Model.InningHalf == HalfInning.Bottom)
                                            {
                                                <i id="caret-down" class="bi bi-caret-down-fill" style="color:white"></i>
                                            }
                                            if (Model.InningHalf == HalfInning.Top)
                                            {
                                                <i id="caret-up" class="bi bi-caret-up-fill" style="color:white"></i>
                                            }
                                            <span id="inningnumber-@Model.GameId" class="sbStyle px-1">@Model.InningNumber</span>
                                        }

                                        <div class="d-none d-lg-inline-block" style="border:1px solid gray;margin-top:0">
                                            <span class="bsoStyle">B</span>
                                            <span id="ball1-@Model.GameId" class="@(Model.Balls > 0 ? "ballDot" : "noBallDot")"></span>
                                            <span id="ball2-@Model.GameId" class="@(Model.Balls > 1 ? "ballDot" : "noBallDot")"></span>
                                            <span id="ball3-@Model.GameId" class="@(Model.Balls > 2 ? "ballDot" : "noBallDot")"></span>
                                            <span class="bsoStyle">S</span>
                                            <span id="strike1-@Model.GameId" class="@(Model.Strikes > 0 ? "strikeDot" : "noStrikeDot")"></span>
                                            <span id="strike2-@Model.GameId" class="@(Model.Strikes > 1 ? "strikeDot" : "noStrikeDot")"></span>
                                            <span class="bsoStyle">O</span>
                                            <span id="out1-@Model.GameId" class="@((Model.Outs == 1 || Model.Outs == 2) ? "outDot" : "noOutDot")"></span>
                                            <span id="out2-@Model.GameId" class="@(Model.Outs == 2 ? "outDot" : "noOutDot") " style="margin-right:4px"></span>
                                        </div>
                                        <div class="base-diamond-container">
                                            <svg viewBox="0 0 100 100" class="base-diamond">
                                                <rect id="base-2" class="base @(Model.IsRunnerOnSecond ? "occupied" : "")" x="42" y="10" width="30" height="30" transform="rotate(45 50 18)" />
                                                <rect id="base-3" class="base @(Model.IsRunnerOnThird ? "occupied" : "")" x="12" y="40" width="30" height="30" transform="rotate(45 20 48)" />
                                                <rect id="base-1" class="base @(Model.IsRunnerOnFirst ? "occupied" : "")" x="72" y="40" width="30" height="30" transform="rotate(45 80 48)" />
                                            </svg>
                                        </div>
                                    </div>
                                </div>
                                @if (Model.GameIsOver)
                                {
                                    <div class="text-white">
                                        <small>Length of Game: @Model.LengthOfGame</small>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-4">
                            <h1 id="homescore-@Model.GameId" class="navbar-text navbar-right scoreStyle">@Model.HomeScore</h1>
                            <h3 id="homeTeamName" class="navbar-text navbar-right ml-lg-3 d-none d-lg-inline teamName">@Model.HomeName</h3>
                            <div class="navbar-brand navbar-right ml-lg-3 d-none d-md-inline">
                                @Html.Image(Model.HomeLogo, "70")
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-1">&nbsp;</div>
            </div>
        </div>
    </div>
</nav>
<div class="container-fluid" style="padding-top:110px">
    <div class="row">
        <div class="col col-md-10 mx-auto" style="max-width:800px">
            <div class="d-none d-md-flex">
                <partial name="LineScore" />
            </div>
        </div>
    </div>
</div>
<div class="container-fluid mt-2">
    <div class="row">
        <div class="col col-md-10 mx-auto">
            <ul class="nav nav-tabs " role="tablist">
                <li role="presentation" class=" nav-item"><a href="#live" aria-controls="live" class="nav-link active " role="tab" data-toggle="tab"><span class="tabText">Live Game Stats</span></a></li>
                <li role="presentation" class="nav-item"><a href="#boxscore" aria-controls="boxscore" class="nav-link " role="tab" data-toggle="tab"><span class="tabText">Full Box Score</span></a></li>
                <li role="presentation" class="nav-item"><a href="#pbp" aria-controls="pbp" role="tab" class="nav-link " data-toggle="tab"><span class="tabText">Play By Play</span></a></li>
            </ul>
            <div class="tab-content">
                <div role="tabpanel" class="tab-pane active scroll" id="live">
                    <div class="row" style="margin-top:5px">
                        <div class="col-12 col-md-6 col-lg-3 order-1">
                            <div id="awayBox" style="margin-right:0;margin-left:auto;text-align:right">
                                <partial name="BoxScore" for="AwayBox" view-data="ViewData" />
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 order-3 order-lg-2">
                            <div class="row">
                                <div class="col-md-12">
                                    <ul class="nav nav-tabs bluebottom" role="tablist">
                                        <li role="presentation" class=" nav-item"><a href="#inning" class="nav-link active" aria-controls="live" role="tab" data-toggle="tab"><span class="tabText">Inning</span></a></li>
                                        <li role="presentation" class="nav-item"><a href="#runners" class="nav-link" aria-controls="live" role="tab" data-toggle="tab"><span class="tabText">Runners</span></a></li>
                                        <li role="presentation" class="nav-item"><a href="#defense" class="nav-link" aria-controls="live" role="tab" data-toggle="tab"><span class="tabText">Defense</span></a></li>
                                    </ul>
                                    <div class="tab-content">
                                        <div role="tabpanel" class="tab-pane active" id="inning">
                                            <div class="row">
                                                <div class="offset-1 col-lg-10 col-xl-7">
                                                    <p id="pitcherLogo" class="mt-2">@Html.Image(Model.PitcherLogo, "25")<span id="currentPitcher">@Html.Raw(object.ReferenceEquals(Model.CurrentPitcher, null) ? "" : string.Format("&nbsp;{0} pitching", Model.CurrentPitcher))</span></p>
                                                    <p id="hitterLogo" >@Html.Image(@Model.HitterLogo, "25")<span id="abresult" class="ms-2">@Model.AbString</span></p>
                                                    <fieldset id="prevabs" style="margin-top:15px">
                                                        <legend>Previous At Bats</legend>
                                                        <ul>
                                                            @foreach (var ab in Model.PreviousAbs)
                                                            {
                                                                <li style="text-align:left">@ab</li>
                                                            }
                                                        </ul>
                                                    </fieldset>
                                                </div>

                                                <div class="offset-1 col-lg-10 col-xl-3">
                                                    <fieldset id="pitches" style="margin-top:8px">
                                                        <legend>Pitches</legend>
                                                        <ol>
                                                            @foreach (var pitch in Model.Pitches)
                                                            {
                                                                <li>@pitch</li>
                                                            }
                                                        </ol>
                                                    </fieldset>
                                                </div>
                                            </div>
                                        </div>
                                        <div role="tabpanel" class="tab-pane" id="runners">

                                            <div class="fieldImg mt-2">
                                                @if (!Model.GameIsOver)
                                                {
                                                    <div class="runner onSecond" style="height:20px;">@Model.RunnerOnSecond</div>
                                                    <div class="runner onThird" style="position:relative;top:80px;left:5px;width:100px;height:30px">@Model.RunnerOnThird</div>
                                                    <div class="runner onFirst" style="position:relative;top:50px;width:100px;height:30px">@Model.RunnerOnFirst</div>
                                                }
                                            </div>
                                        </div>
                                        <div role="tabpanel" class="tab-pane" id="defense">
                                            <partial name="DefensiveAlignment" for="Defense" view-data="ViewData" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="offset-1 col-xs-10">
                                    <fieldset id="scoringplays" style="margin-top:15px">
                                        <legend>Scoring Plays</legend>
                                        @Html.DisplayFor(m => m.ScoringPlays)
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                        <div id="homebox" class="col-12 col-md-6 col-lg-3 order-2 order-lg-3">
                            @{
                                ViewData["home"] = true;
                                ViewData["logo"] = Model.HomeLogo;
                                ViewData["team"] = Model.HomeName;
                            }
                            <partial name="BoxScore" for="HomeBox" view-data="ViewData" />
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane" id="boxscore">
                    <div class="row" style="margin-top:5px">
                        <div class="col-xl-6">
                            <p class="teamName">@Html.Image(Model.AwayLogo, "35")<span style="margin-left:5px">@Model.AwayName</span></p>
                            @if (Model.AwayBox.HittingBox.Stats.Any())
                            {
                                @Html.Table(Model.AwayBox.HittingBox.Stats, new { @class = "scoreTable wide" })
                                ;
                            }
                            @if (Model.HomeBox.PitchingBox.Stats.Any())
                            {
                                @Html.Table(Model.AwayBox.PitchingBox.Stats, new { @class = "scoreTable wide" })
                                ;
                            }
                        </div>
                        <div class="col-xl-6">
                            <p class="teamName">@Html.Image(Model.HomeLogo, "35")<span style="margin-left:5px;">@Model.HomeName</span></p>
                            @if (Model.HomeBox.HittingBox.Stats.Any())
                            {
                                @Html.Table(Model.HomeBox.HittingBox.Stats, new { @class = "scoreTable wide" })
                            }
                            @if (Model.HomeBox.PitchingBox.Stats.Any())
                            {
                                @Html.Table(Model.HomeBox.PitchingBox.Stats, new { @class = "scoreTable wide" })
                            }
                        </div>
                    </div>
                </div>
                <div role="tabpanel" class="tab-pane scroll" id="pbp">
                    <div class="row">
                        <div id="playbyplay" class="col-md-8">
                            @Html.DisplayFor(m => m.Innings)
                        </div>
                        <div id="pbpscoring" class="col-md-4">
                            @Html.DisplayFor(m => m.ScoringPlays)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

