@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
<h2>CMBA Scoreboard app v1.0</h2>
<ul>
    <li><strong class="pe-2">Platform:</strong>&nbsp;Android 11.0 or higher</li>
    <li><strong class="pe-2">Release Date:</strong>&nbsp;April 2026</li>
    <li><strong class="pe-2">Note:</strong>&nbsp;Enable "Install from Unknown Sources" in your phone settings to complete installation</li>
    <li>
        <a href="~/Content/com.companyname.scoreboardapp.apk">Download for Android</a>
    </li>
    @if (Context.Request.Query["manager"] == "true" && Configuration["GameSettings:ShowAppLink"]=="true")
    {
        <environment include="Staging">
            <li>&nbsp;|&nbsp;<a href="~/Content/electronsbaseball.electronsbaseball.apk">Download for Android (Manager Build)</a></li>
        </environment>
    }
</ul>
