@model ProfileModel
@using Elecredesign;
@using Electrons.Net8
@using Electrons.Net8.Models
@{
    ViewBag.Title = string.Format("Player Profile - {0}", Model.FullName);
}
<div style="color:#800000">
    <div class="row mt-3">
        <div class="col col-sm-3">
            <div class="row">
                <div class="col ml-auto">
                    <img src="@Model.ImageFile" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(Model.AwardString))
            {
                <div class="row">
                    <div class="col ml-auto">
                        <label>Awards:</label>
                        <span style="margin-left:10px">@Html.Raw(Model.AwardString)</span>
                    </div>
                </div>
            }
        </div>
        <div class="col col-sm-8 ml-auto">
            <div class="row">
                <div class="col-sm-10"><h3>@Model.DisplayName</h3></div>
            </div>
            <div class="row">

                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Hometown)<span style="margin-left:10px">@Model.Hometown</span></div></div>
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Height)<span style="margin-left:10px">@Model.Height</span></div></div>
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Weight)<span style="margin-left:10px">@string.Format("{0} lbs.", Model.Weight)</span></div></div>

            </div>
            <div class="row">
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Positions)<span style="margin-left:10px">@Model.Positions</span></div></div>
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Bats)<span style="margin-left:10px">@Model.Bats</span></div></div>
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Throws)<span style="margin-left:10px">@Model.Throws</span></div></div>
            </div>
            <div class="row">
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.DOB)<span style="margin-left:10px">@Model.DOB</span></div></div>
                <div class="col col-sm-4"><div>@Html.LabelFor(m=>m.Divorces)<span style="margin-left:10px">@Model.Divorces</span></div></div>
                <div class="col col-sm-4">&nbsp;</div>
            </div>
            <div class="row">
                <div class="col col-sm-12"><div>@Html.LabelFor(m=>m.YearDisplay)<span style="margin-left:10px">@Model.YearDisplay</span></div></div>

            </div>
            @if (Model.PitchingStats.Any())
            {
                <div>
                    <div class="col col-sm-11"><h4>Pitching Stats</h4></div>
                    <div class="col col-sm-11">@Html.Table(Model.PitchingStats, "tronTable", "tronTable", "tronTable oddrow", new { @class = "tronTable" }, true)</div>
                </div>
            }
            @if (Model.HittingStats.Any())
            {
                <div>
                    <div class="col-sm-11"><h4>Hitting Stats</h4></div>
                    <div class="col-sm-11">@Html.Table(Model.HittingStats, "tronTable", "tronTable", "tronTable oddrow", new { @class = "tronTable" }, true)</div>
                </div>
            }
        </div>
    </div>
</div>
