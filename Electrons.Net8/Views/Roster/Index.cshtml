@model RosterModel
@using Elecredesign;
@using Electrons.Net8
@using Electrons.Net8.Models
@{
    ViewBag.Title = "Roster";
}

<div class="row">
    <div class="col col-auto mx-auto align-content-center" >
        <h2>Current Electrons Roster</h2>
    </div>
</div>
<div class="row">
    <div class="col col-sm-8 mx-auto">
        @Html.Table(m => m.Roster, "tronTable", "tronTable", "tronTable oddrow", new { @class = "tronTable", style = "width:900px;margin-left:auto;margin-right:auto" })
    </div>
</div>
