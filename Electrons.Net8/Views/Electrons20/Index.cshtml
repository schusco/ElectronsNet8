@{
    ViewBag.Title = "Electrons 20th aniversary party information.";
}
<link href="~/Content/style.css" rel="stylesheet" />
<header>
    <h1>Winnemac Electrons: Celebrating 20 Years of Baseball</h1>
</header>
<div class="container">
    <div class="row">
        <div class="col-sm-12 center">
            <h2 style="margin:auto">Saturday, September 3rd 2022</h2>
        </div>
    </div>
    <div class="row">
        <div class="col-md-2">
            <img id="bio-image" src="~/Content/images/Electrons20.jpeg" alt="20 Years and Counting" />
        </div>
        <div class="col-md-6 ml-5">
            <p>20 years ago, a couple of visionaries put together a baseball team on the Northside.</p>
            <p>After over 270 losses (and counting) the time has finally come to "rub some dirt on it".</p>
            <p>Join us Labor Day weekend in Chicago for an all-day celebration of Electrons Baseball!</p>
        </div>
        <div class="col-md-3">
            <h2>To Sign-Up</h2>
            <ul>
                <li><strong>Send an Email:</strong> <a href="mailto: electrons20th@gmail.com">electrons20th@gmail.com</a></li>
            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <p>A celebration so professional, you won't believe it's us!</p>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">

            <h3>Schedule of Events</h3>

            <p><strong>10 A.M.</strong> Electrons Old-Timers Game (Winnemac Park) </p>

            <p><strong>7 P.M. - 10 P.M. </strong> 20th Anniversary Semi-Formal (Spiteful Brewing Company)</p>

            <p><strong>10 P.M.</strong> After Party (K's Dugout) </p>

            <h3>Further Details</h3>

            <ul>

                <li>
                    <p>The 20th Anniversary Semi-Formal event is limited and reserved for 80-100 past and present Electrons (+ date).</p>
                </li>
                <li><p>We have reserved the entire indoor space at Spiteful Brewery for the evening.</p></li>
                <li><p>Event is pre-paid, with cost covering 3 hours of draft beer, wine and catered food.</p></li>
                <li><p> Semi-Formal will feature an "Open Mic Hour" hosted by Electron Legends, Rez & Rock!</p></li>
                <li><p>Semi-Formal attire encouraged, but not required</p></li>

            </ul>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h3>Registration and Pricing Details</h3>

            <ul>
                <li><p>Final cost will be determined by registration numbers and collected closer to the event.</p></li>
                <li><p>A pre-paid bar tab of $2250 is in place. Once that amount is met, the bar will pivot to cash-bar.</p></li>
                <li><p>Catered food will be provided (Pizza, Pasta, Salads) from a local favorite</p></li>
                <li><p>A flat, per-person fee will cover the bar tab + gratuity, food and commemorative item</p></li>
                <li><p>Based on initial projections, cost will be between $30-$50 per person/$60-$100 per couple.</p></li>
            </ul>
            <p> Check back on this page for further details closer to the event.</p>
        </div>
    </div>
</div>
